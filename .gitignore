# ---- DSH / GraphFlow tooling artifacts (not project source) ----
.graphflow/
.graphflow-cache/
graphflow-out/
*.sqlite-wal
*.sqlite-shm

# ---- agent workspace data (memory logs, plans; not project source) ----
.workbuddy/

# ---- OS / editor noise ----
.DS_Store
Thumbs.db
*.swp
desktop.ini

# ---- local scratch dir (build temp, one-off scripts) ----
.tmp/

# ---- local package cache (npm --cache, kept in-tree to satisfy sandbox writes) ----
.npm-cache/

# ---- generic safety nets (app/.gitignore covers the app subtree) ----
node_modules/
dist/
.env
.env.local
